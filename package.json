{
  "name": "visualize-app",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^6.8.0",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "react": "^19.1.1",
    "react-dom": "^19.1.1",
    "react-scripts": "5.0.1",
    "web-vitals": "^2.1.4"
  },
  "homepage": ".",
  "scripts": {
    "prestart": "npm run generate:appendix",
    "start": "react-scripts start",
    "prebuild": "npm run generate:appendix",
    "build": "react-scripts build",
    "test": "react-scripts test",
    "eject": "react-scripts eject",
    "gen:basic": "node scripts/gen_basic_json.js",
    "gen:social": "node scripts/gen_social_json.js",
    "gen:data": "npm run gen:basic && npm run gen:social",
    "generate:appendix": "node scripts/generate-appendix-data.mjs",
    "fetch:egov-screening": "node scripts/fetch-egov-law-screening.mjs",
    "preverify": "npm run generate:appendix",
    "verify": "node scripts/verify-social-insurance.mjs && node scripts/verify-independent-oracle.mjs && node scripts/verify-source-coverage.mjs && node scripts/verify.mjs && node scripts/verify-appendix-data.mjs",
