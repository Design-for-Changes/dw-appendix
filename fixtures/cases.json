{
  "$schema_note": "各ケースは給与掃引で現れる崖の期待値。限度額判定に渡す扶養人数は実人数＋法定加算のみとし、障害を理由とする人数加算は含めない。特児停止・障害児福祉手当停止は制度式による値、通所境界は計算コアの住民税所得割による値。",
  "model_baseline": {
    "household": "単身世帯（配偶者なし）。世帯主＝就労する親（給与を掃引）。障害児は10歳・同居・特別障害者。",
    "head": {
      "age": 40,
      "note": "40歳以上＝介護保険料あり(social_o40)。"
    },
    "child_disability": "特児判定では特別障害者40万円控除、住民税側では同居特別障害者53万円控除。",
    "fuyoCount_rule": "限度額判定に渡す扶養人数は扶養親族等の実人数＋法定加算（特定扶養・老人扶養等）のみ。障害を理由とする人数加算は含めない。10歳児は法定加算ゼロ。",
    "welfare_allowance_income_rule": "障害児福祉手当の扶養義務者判定所得は、所得金額調整控除を入れない給与所得−10万円（給与調整）−8万円（社保相当固定）−障害者控除（本ケースは特別障害者40万円×人数）。実社会保険料・基礎控除・住民税用障害者控除は使わない。",
    "scenario": "S3_R8_R9",
    "scenario_note": "税制シナリオS3＝令和8〜9年度（2026〜2027）。scenarios.json の key='s3' に対応。",
    "units": "salaryManyen・dropManyen はいずれも万円。dropは負値（下向きの崖）。"
  },
  "tolerance": {
    "salaryTolManyen": 1,
    "dropTolManyen": 1,
    "note": "掃引ステップが1万なら salary は±1万、落差は±1.0万を許容。回帰検出用でありこの範囲を超えたら差分とみなす。"
  },
